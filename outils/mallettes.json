            "^(input|output)/(.+/)?(README|LISEZMOI)\\.md$"
          ],
          "exclure": [
            "^input/00-retours/old/",
            "^todo/.*\\.jsonl$",
            "^todo/TF-decisions-",
            "^todo/registre-dette\\.json$",
            "^todo/oeil-critique-",
            "^todo/observabilite/RECIDIVES\\.json$"
          ],
          "marqueur": "Copie embarquée de la partie outil du pilot (doctrine, oracles, gabarits, scripts), livrée par la mallette factory-socle. Elle n'est pas un clone : rien ne s'y tire ni ne s'y pousse, et la marketplace la met à jour. Ce que le poste y écrit (TODO, retours) reste sur le poste.",
          "garder": [
            "^\\.claude/agents/"
          ]
        },
        {
          "depot": "factory-forge-design",
          "garder": [
            "^skills/"
          ],
          "exclure": [
            "^(input|output)/",
            "^TODO\\.md$"
          ]
        }
      ]
    },
